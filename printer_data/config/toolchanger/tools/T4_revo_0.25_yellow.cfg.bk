#Voron Revo 0.25 yellow nozzle
[mcu T4]
serial: /dev/serial/by-id/usb-Klipper_rp2040_3033393834059FB1-if00 #Revo
restart_method: command

[tool T4]
tool_number: 4
extruder: extruder4
fan: T4_part_fan
gcode_x_offset: 0
gcode_y_offset: 0
gcode_z_offset: 1.400
params_park_x: 295.60
params_park_y: -4
params_park_z: 243
#params_input_shaper_type_x: 'mzv'
#params_input_shaper_freq_x: 62.2
#params_input_shaper_damping_ratio_x: 0.01
#params_input_shaper_type_y: 'mzv'
#params_input_shaper_freq_y: 44.0
#params_input_shaper_damping_ratio_y: 0.01

[tool_probe T4]
pin: T4:gpio10
tool: 4
z_offset: 0  # Needs to be calibrated. More positive = More Squish
speed: 5.0
samples: 3
samples_result: median
sample_retract_dist: 2.0
samples_tolerance: 0.02
samples_tolerance_retries: 3
activate_gcode:
    _TAP_PROBE_ACTIVATE HEATER=extruder4

[extruder4]
step_pin: T4:gpio23
dir_pin: !T4:gpio24
enable_pin: !T4:gpio25
full_steps_per_rotation: 200
microsteps: 32
gear_ratio: 9:1
nozzle_diameter: 0.25
filament_diameter: 1.75
rotation_distance: 47.232801986  #New RD = Old RD *(120-x)/100  #####  G1 E100 F100   ####
heater_pin: T4:gpio9
sensor_pin: T4:gpio29
pullup_resistor: 2200
sensor_type: ATC Semitec 104GT-2
control: pid
pid_Kp=31.758
pid_Ki=6.227
pid_Kd=40.492
smooth_time: 2.0
min_temp: 0
max_temp: 270
max_power: 1.0
min_extrude_temp: 180
max_extrude_cross_section: 5
pressure_advance: 0.03
pressure_advance_smooth_time: 0.040

[tmc2209 extruder4]
uart_pin: T4:gpio0
tx_pin: T4:gpio1
interpolate: false
sense_resistor: 0.100
run_current: 0.8

[fan_generic T4_part_fan]
pin: T4:gpio6

[heater_fan T4_hotend_fan]
pin: T4:gpio5
heater: extruder4
heater_temp: 50.0

[temperature_sensor NHK4]
sensor_type: temperature_mcu
sensor_mcu: T4
min_temp: 0
max_temp: 100

[adxl345 T4]
cs_pin: T4:gpio27
spi_software_sclk_pin: T4:gpio18
spi_software_mosi_pin: T4:gpio20
spi_software_miso_pin: T4:gpio19
axes_map: x,z,y

[neopixel T4_leds]
pin: T4:gpio7
chain_count: 3
color_order: GRBW
initial_RED: 0.5
initial_GREEN: 0.0
initial_BLUE: 1.0
initial_WHITE: 0.0

[gcode_macro _T4_vars]
variable_logo_led_name:         "T4_leds"
variable_logo_idx:              "3"
variable_nozzle_led_name:       "T4_leds"
variable_nozzle_idx:            "1,2"
gcode:

[gcode_macro T4]
variable_active: 0 # Must be zero.
variable_color: ""
gcode:
  SELECT_TOOL T=4